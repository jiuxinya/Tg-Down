# 二进制文件
tg-down
tg-down.exe
*.exe

# 日志文件
*.log

# 配置文件（包含敏感信息）
config.yaml
.env

# 下载目录
downloads/

# 临时文件
*.tmp
*.temp

# Go相关
vendor/

# IDE文件
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 会话文件（包含敏感登录信息）
sessions/
session*.json
*.session

# 本地任务/下载历史数据库（含聊天ID、消息ID、文件名/路径等隐私元数据）
tg-down.db
tg-down.db-shm
tg-down.db-wal
*.db
*.db-shm
*.db-wal

# 前端构建（Vite）
web/node_modules/
internal/web/static/dist/*
!internal/web/static/dist/.gitkeep

# 桌面客户端打包产物
dist/
tg-down-desktop
# 裸跑 go build ./cmd/desktop 会在根目录产出名为 desktop 的二进制。
# 必须锚定为 /desktop：不加斜杠会连 cmd/desktop 与 internal/desktop 目录一起忽略。
/desktop
